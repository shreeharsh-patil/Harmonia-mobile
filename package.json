{
  "name": "harmonia-mobile",
  "version": "0.3.2",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "build:apk": "eas build -p android --profile preview",
    "build:android": "eas build -p android --profile production",
    "test": "node --import tsx --test tests/playback/**/*.test.ts",
    "sync:catalog": "node scripts/sync-static-catalog.mjs",
    "eas-build-post-install": "npm run sync:catalog:required",
    "sync:catalog:required": "node scripts/sync-static-catalog.mjs --required"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "crypto-js": "^4.2.0",
    "expo": "~57.0.23",
    "expo-asset": "~57.0.17",
    "expo-audio": "~57.0.4",
    "expo-constants": "~57.0.18",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-image-manipulator": "~57.0.18",
    "expo-image-picker": "~57.0.18",
    "expo-linear-gradient": "~57.0.0",
    "expo-linking": "~57.0.9",
    "expo-media-library": "~57.0.5",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.4",
    "expo-web-browser": "~57.0.2",
    "jpeg-js": "^0.4.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-youtube-iframe": "^2.4.1"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/jpeg-js": "^0.3.0",
    "@types/node": "^24.13.5",
    "@types/react": "~19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "tsx": "^4.20.5",
    "typescript": "~6.0.3"
  }
}

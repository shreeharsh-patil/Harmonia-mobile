{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_HARMONIA_API_URL": "https://harmonia-mobile-backend.vercel.app",
        "EXPO_PUBLIC_HARMONIA_STREAM_API_URL": "https://harmonia-mobile-backend.vercel.app"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_HARMONIA_API_URL": "https://harmonia-mobile-backend.vercel.app",
        "EXPO_PUBLIC_HARMONIA_STREAM_API_URL": "https://harmonia-mobile-backend.vercel.app"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_HARMONIA_API_URL": "https://harmonia-mobile-backend.vercel.app",
        "EXPO_PUBLIC_HARMONIA_STREAM_API_URL": "https://harmonia-mobile-backend.vercel.app"
      },
      "channel": "production"
    }
  }
}

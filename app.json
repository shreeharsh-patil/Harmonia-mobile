{
  "expo": {
    "name": "Harmonia",
    "slug": "harmonia-mobile",
    "version": "0.3.5",
    "orientation": "portrait",
    "scheme": [
      "harmonia",
      "com.harmonia.app"
    ],
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070707",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/ddd559f3-3767-44df-a4ea-5a9a1a481129",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-media-library",
        {
          "granularPermissions": [
            "audio"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Harmonia uses your photo library only when you choose a profile picture.",
          "cameraPermission": "Harmonia uses your camera only when you choose to take a profile picture.",
          "microphonePermission": false
        }
      ]
    ],
    "android": {
      "package": "com.harmonia.app",
      "versionCode": 7,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.WAKE_LOCK"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#070707",
        "foregroundImage": "./assets/harmonia-icon.png"
      }
    },
    "ios": {
      "bundleIdentifier": "com.harmonia.app",
      "buildNumber": "7",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "experiments": {
      "typedRoutes": true,
      "inlineModules": {
        "watchedDirectories": [
          "app"
        ]
      }
    },
    "icon": "./assets/harmonia-icon.png",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ddd559f3-3767-44df-a4ea-5a9a1a481129"
      }
    },
    "owner": "shreeharsh17"
  }
}

# Optional public base URL for YOUR Harmonia account/catalog API.
# Leave unset for playback-only review builds. Do not point this at third-party apps you do not control.
# EXPO_PUBLIC_HARMONIA_API_URL=https://your-harmonia-api.example

# Public Spotify Canvas service used directly by the APK.
# This is a public client URL, not a secret. Render is not involved in Canvas lookups.
# EXPO_PUBLIC_SPOTIFY_CANVAS_API_URL=https://spotify-canvas-one.vercel.app

# Optional dedicated Harmonia stream fallback service.
# Embedded audio and direct JioSaavn playback do not require this.
# EXPO_PUBLIC_HARMONIA_STREAM_API_URL=https://your-harmonia-stream-backend.example

# Build-only secret used to read the private Harmonia-Spotify-Downloader catalog.
# Give this token read-only access to repository Contents. It is NOT EXPO_PUBLIC and is not bundled into the APK.
# HARMONIA_CATALOG_GITHUB_TOKEN=github_pat_...
# HARMONIA_CATALOG_GITHUB_REF=main

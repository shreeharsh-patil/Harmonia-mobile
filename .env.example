# Public base URL for the deployed Harmonia web/API service.
# Current production deployment:
EXPO_PUBLIC_HARMONIA_API_URL=https://jammify-music.vercel.app

# Optional: deployed Harmonia Flask streaming resolver.
# This server owns Piped/yt-dlp fallback for POST /api/stream-track.
# Never put YouTube cookies or private extraction credentials in EXPO_PUBLIC_*.
# EXPO_PUBLIC_HARMONIA_STREAM_API_URL=https://your-harmonia-stream-backend.example
